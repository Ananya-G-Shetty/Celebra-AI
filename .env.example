# ==========================================================
# Celebra AI - Environment Configuration
# Google Build with AI – PromptWars Challenge 5
# ==========================================================

# Google Gemini API Key
# If not provided, Celebra AI automatically falls back to its built-in
# Indian Cultural Intelligence Engine for zero-configuration testing & CI.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Optional, defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Node Environment
NODE_ENV=development
